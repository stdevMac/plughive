{
  "schema": 1,
  "goals": [
    {
      "id": "short-videos",
      "title": "Make short videos",
      "summary": "Cut, caption and voice short clips for Reels, Shorts and TikTok.",
      "match": [
        "short video",
        "shorts",
        "reels",
        "tiktok",
        "clip",
        "video edit",
        "make videos",
        "videos"
      ],
      "steps": [
        {
          "need": "Cut, resize and caption video",
          "options": [
            {
              "needs": "install",
              "id": "ffmpeg",
              "cost": "free",
              "local": true,
              "why": "ffmpeg does the cutting, resizing and caption burn-in on this machine."
            }
          ]
        },
        {
          "need": "Write captions from the speech",
          "capability": "audio.transcribe",
          "options": [
            {
              "needs": "install",
              "id": "parakeet-mlx",
              "cost": "free",
              "local": true,
              "why": "Fast, accurate transcription on Apple silicon, offline."
            },
            {
              "needs": "install",
              "id": "whisper.cpp",
              "cost": "free",
              "local": true,
              "why": "Offline transcription that runs on any computer.",
              "with": ["whisper-model-base"]
            },
            {
              "needs": "key",
              "id": "GEMINI_API_KEY",
              "pack": "gemini",
              "cost": "free_tier",
              "local": false,
              "why": "Gemini transcribes in the cloud; its free tier covers short clips."
            },
            {
              "needs": "key",
              "id": "ELEVENLABS_API_KEY",
              "pack": "elevenlabs",
              "cost": "free_tier",
              "local": false,
              "why": "ElevenLabs Scribe transcribes in the cloud with word timings."
            }
          ]
        },
        {
          "need": "Add a voice-over",
          "capability": "speech.generate",
          "optional": true,
          "options": [
            {
              "needs": "install",
              "id": "kokoro",
              "cost": "free",
              "local": true,
              "why": "Kokoro speaks text aloud on this machine, no account."
            },
            {
              "needs": "key",
              "id": "ELEVENLABS_API_KEY",
              "pack": "elevenlabs",
              "cost": "free_tier",
              "local": false,
              "why": "The most natural voices; a free tier with a monthly allowance."
            },
            {
              "needs": "key",
              "id": "GEMINI_API_KEY",
              "pack": "gemini",
              "cost": "free_tier",
              "local": false,
              "why": "Gemini speech with many voices."
            }
          ]
        },
        {
          "need": "Grab source clips from the web",
          "optional": true,
          "options": [
            {
              "needs": "install",
              "id": "yt-dlp",
              "cost": "free",
              "local": true,
              "why": "Downloads clips you have the right to use from YouTube and other sites."
            }
          ]
        },
        {
          "need": "Ready-made short-video workflow",
          "optional": true,
          "options": [
            {
              "needs": "enable_pack",
              "id": "workflows",
              "cost": "free",
              "local": true,
              "why": "Runs the whole short-video recipe in one call."
            }
          ]
        }
      ]
    },
    {
      "id": "transcribe-meetings",
      "title": "Transcribe meetings",
      "summary": "Turn recordings into text and summaries.",
      "match": [
        "transcribe",
        "transcript",
        "meeting",
        "meetings",
        "recording",
        "subtitles",
        "dictation",
        "notes from calls"
      ],
      "steps": [
        {
          "need": "Read audio and video files",
          "options": [
            {
              "needs": "install",
              "id": "ffmpeg",
              "cost": "free",
              "local": true,
              "why": "Converts any recording into the audio the transcriber reads."
            }
          ]
        },
        {
          "need": "Turn speech into text",
          "capability": "audio.transcribe",
          "options": [
            {
              "needs": "install",
              "id": "parakeet-mlx",
              "cost": "free",
              "local": true,
              "why": "Fast, accurate and offline on Apple silicon: recordings never leave the machine."
            },
            {
              "needs": "install",
              "id": "whisper.cpp",
              "cost": "free",
              "local": true,
              "why": "Offline transcription on any computer.",
              "with": ["whisper-model-base"]
            },
            {
              "needs": "install",
              "id": "whisperx",
              "cost": "free",
              "local": true,
              "why": "Offline transcription that also tells speakers apart (large download)."
            },
            {
              "needs": "key",
              "id": "GEMINI_API_KEY",
              "pack": "gemini",
              "cost": "free_tier",
              "local": false,
              "why": "Cloud transcription with a free tier."
            },
            {
              "needs": "key",
              "id": "ELEVENLABS_API_KEY",
              "pack": "elevenlabs",
              "cost": "free_tier",
              "local": false,
              "why": "Cloud transcription with speaker labels."
            },
            {
              "needs": "key",
              "id": "OPENROUTER_API_KEY",
              "pack": "openrouter",
              "cost": "paid",
              "local": false,
              "why": "Pay-as-you-go access to several transcription models."
            }
          ]
        },
        {
          "need": "Summarise the transcript",
          "capability": "chat",
          "optional": true,
          "options": [
            {
              "needs": "install",
              "id": "ollama",
              "cost": "free",
              "local": true,
              "why": "Runs a language model on this machine for private summaries."
            },
            {
              "needs": "key",
              "id": "GEMINI_API_KEY",
              "pack": "gemini",
              "cost": "free_tier",
              "local": false,
              "why": "Gemini summarises long transcripts in the cloud."
            }
          ]
        },
        {
          "need": "Dictate anywhere on your Mac",
          "optional": true,
          "options": [
            {
              "needs": "install",
              "id": "hex",
              "cost": "free",
              "local": true,
              "why": "Hold a key and talk; the text is typed where your cursor is."
            }
          ]
        }
      ]
    },
