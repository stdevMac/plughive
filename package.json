{
  "name": "plughive",
  "version": "0.1.0",
  "description": "A local MCP gateway: one endpoint for your agents, with your own provider keys.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stdevMac/plughive.git"
  },
  "homepage": "https://github.com/stdevMac/plughive#readme",
  "bugs": {
    "url": "https://github.com/stdevMac/plughive/issues"
  },
  "type": "module",
  "bin": {
    "plughive": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/packs",
    "dist/web/dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/.env*",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": ["mcp", "model-context-protocol", "gateway", "mcp-server", "byok"],
  "scripts": {
    "dev": "tsx --conditions=plughive-source src/server.ts",
    "dev:watch": "tsx watch --conditions=plughive-source src/server.ts",
    "build": "tsc -p tsconfig.json && pnpm build:web && node scripts/copy-skills.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm clean && pnpm build && pnpm check:pack",
    "check:pack": "node scripts/check-pack.mjs",
    "build:web": "pnpm --filter @plughive/web build",
    "test:web": "pnpm --filter @plughive/web test",
    "e2e:dashboard": "tsx scripts/e2e-dashboard.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:ci": "tsx scripts/ci-smoke.ts",
    "live-check": "tsx scripts/live-check.ts",
    "check": "tsx scripts/doctor.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "licenses": "node scripts/check-licenses.mjs",
    "docs:packs": "tsx scripts/gen-pack-docs.ts",
    "i18n:new": "node scripts/i18n.mjs new",
    "i18n:status": "node scripts/i18n.mjs status"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/keyring": "2.1.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "execa": "^9.5.0",
    "express": "^4.22.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1",
    "sharp": "^0.35.5",
    "sqlite-vec": "0.1.9",
    "ulid": "^2.3.0",
    "undici": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.0.0",
  "exports": {
    "./pack": {
      "types": "./src/core/pack-api.ts",
      "plughive-source": "./src/core/pack-api.ts",
      "default": "./dist/src/core/pack-api.js"
    },
    "./pack/testing": {
      "types": "./src/core/packs/testing.ts",
      "plughive-source": "./src/core/packs/testing.ts",
      "default": "./dist/src/core/packs/testing.js"
    }
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8 <3",
      "body-parser@1": ">=1.20.9 <2",
      "qs@6": ">=6.16.1 <7",
      "fast-copy": ">=4.1.0 <5"
    }
  }
}
