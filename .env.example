# plughive reads this file at start unless PLUGHIVE_NO_DOTENV=1 is set in the
# real environment. Every line is optional: with an empty file the daemon
# listens on http://127.0.0.1:7777 and keeps its state in ~/.plughive.

# ---------------------------------------------------------------------------
# Provider keys
# ---------------------------------------------------------------------------
# Keys belong in the secret store, not here: open the dashboard and paste each
# key under Secrets (on macOS they are kept in the Keychain). A stored key wins
# over the environment.
#
# The environment is a fallback for bundled packs only: a name below is read
# from here when the store has nothing under it. Packs you add yourself and
# MCP servers you mount never read the environment.
# OPENROUTER_API_KEY=
# FAL_KEY=
# REPLICATE_API_TOKEN=
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=
# FIRECRAWL_API_KEY=
# APOLLO_API_KEY=
# DUB_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Where the daemon listens
# ---------------------------------------------------------------------------
# PLUGHIVE_PORT=7777
# Bind address. Anything other than loopback (for example 0.0.0.0) exposes the
# daemon on your network and requires PLUGHIVE_ACCESS_KEY.
# PLUGHIVE_BIND_HOST=127.0.0.1
# The origin people reach the daemon on (scheme://host[:port], no path), for
# example https://store.example.com behind a TLS proxy. Every link the daemon
# hands out starts with it and browser requests are checked against it. Unset:
# derived from the bind address and port, never from the request's Host header.
# PLUGHIVE_PUBLIC_URL=
# Extra browser origins allowed to call /mcp, /p/* and /api/* (comma-separated).
# By default only the daemon's own origin may. Requests without an Origin
# header (every non-browser MCP client) are not affected.
# PLUGHIVE_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Who may call it
# ---------------------------------------------------------------------------
# Access key for MCP clients. When set, /mcp, /p/* and /artifacts require
# "Authorization: Bearer <key>" or "X-API-Key: <key>". The daemon refuses to
# start on a non-loopback bind address without it.
# PLUGHIVE_ACCESS_KEY=
# Admin token for the dashboard and /api (always required there). Unset: the
# daemon creates one on first start, keeps it in its home folder (owner-only)
# and prints a sign-in link to the terminal. Set it (24 characters or more) to
# choose the token yourself, for example when running under a service manager.
# PLUGHIVE_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# State and secrets
# ---------------------------------------------------------------------------
# Home folder: databases, artifacts, your packs, settings. Default ~/.plughive.
# (PLUGHIVE_ROOT, the older name, is still read and wins when both are set.)
# PLUGHIVE_HOME=
# Where saved keys live: "keychain" (default on macOS), "file" (default
# elsewhere: secrets.json in the home folder) or "memory" (lost at exit; tests).
# PLUGHIVE_SECRETS=
# Passphrase that encrypts secrets.json when the file store is used.
# PLUGHIVE_SECRETS_PASSPHRASE=
# Local folders import_artifact may read files from (comma-separated).
# PLUGHIVE_IMPORT_ROOTS=
# Folder with the built dashboard. Default: web/dist next to the code.
# PLUGHIVE_WEB_DIR=

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Long-running tool calls that run at once.
# PLUGHIVE_JOB_CONCURRENCY=2
# Jobs waiting to run are capped; new long-running calls are refused above
# this. Finished jobs are pruned after 7 days or beyond the newest 1000.
# PLUGHIVE_MAX_QUEUED_JOBS=200

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
# trace, debug, info (default), warn, error or silent.
# PLUGHIVE_LOG_LEVEL=info
# Terminal output is human-readable when stdout is a terminal and JSON
# otherwise. 1 forces readable lines, 0 forces JSON. The log file in
# <home>/logs/server.jsonl is always JSON.
# PLUGHIVE_LOG_PRETTY=
# 1: the call log records argument values (masked) instead of only their names
# and sizes. Leave off unless you are debugging a pack.
# PLUGHIVE_LOG_ARGS=
